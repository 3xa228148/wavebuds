    <string name="opt_off">Выкл</string>
    <string name="opt_on">Вкл</string>

    <string name="sec_ambient">Окружающий звук</string>
    <string name="desc_ambient">Ambient Aware пропускает звуки вокруг. TalkThru приглушает музыку и выводит голоса вперёд, чтобы быстро перекинуться парой слов.</string>
    <string name="opt_aa">Ambient Aware</string>
    <string name="opt_tt">TalkThru</string>

    <string name="sec_va">VoiceAware</string>
    <string name="desc_va">Насколько громко вы слышите свой голос в наушниках во время звонка.</string>
    <string name="opt_low">Низк.</string>
    <string name="opt_mid">Средн.</string>
    <string name="opt_high">Высок.</string>

    <string name="sec_sav">Умное аудио и видео</string>
    <string name="desc_sav">Аудио: лучшее качество звука. Видео: меньше задержка для видео и игр. Выкл: обычный режим. При переключении наушники перезапускаются, связь возвращается сама примерно через 15 секунд.</string>
    <string name="opt_audio">Аудио</string>
    <string name="opt_video">Видео</string>

    <string name="sec_eq">Эквалайзер</string>
    <string name="desc_eq">«Выкл» оставляет фирменный звук наушников. Выберите пресет или нарисуйте свою кривую, изменения применяются сразу.</string>
    <string name="eq_custom">Свой</string>
    <string name="eq_flatten">Сбросить</string>
    <string name="eq_db">%1$+.1f дБ</string>

    <string name="sec_gestures">Жесты</string>
    <string name="desc_gestures">Что делает касание наушника. Управление звонками работает всегда: двойное касание принимает или завершает вызов, касание с удержанием отклоняет вызов или выключает микрофон.</string>
    <string name="gest_left">Левый наушник</string>
    <string name="gest_right">Правый наушник</string>
    <string name="ges_none">Ничего</string>
    <string name="ges_ambient">Окружающий звук</string>
    <string name="ges_volume">Громкость</string>
    <string name="ges_playback">Воспроизведение</string>
    <string name="ges_desc_none">Касания ничего не делают (звонки управляются как обычно).</string>
    <string name="ges_desc_ambient">Касание: режим окружения · двойное: TalkThru · удержание: голосовой ассистент</string>
    <string name="ges_desc_volume">Касание: громче · двойное: тише · удержание: голосовой ассистент</string>
    <string name="ges_desc_playback">Касание: пауза/play · двойное: следующий трек · тройное: предыдущий · удержание: голосовой ассистент</string>

    <string name="sec_other">Прочее</string>
    <string name="prompts">Голосовые подсказки</string>
    <string name="desc_prompts">Короткие фразы от наушников (включение, сопряжение, смена режима).</string>
    <string name="limiter">Ограничитель громкости</string>
    <string name="desc_limiter">Не даёт выкрутить громкость слишком сильно, бережёт слух.</string>

    <string name="sec_autooff">Автовыключение</string>
    <string name="desc_autooff">Наушники выключатся сами, если ими не пользуются столько времени.</string>
    <string name="opt_30m">30 мин</string>
    <string name="opt_1h">1 ч</string>
    <string name="opt_2h">2 ч</string>

    <string name="sec_find">Найти наушники</string>
    <string name="desc_find">Выбранный наушник громко пищит. Сначала выньте наушники из ушей!</string>
    <string name="find_left">Левый</string>
    <string name="find_right">Правый</string>
    <string name="find_stop">Стоп</string>

    <string name="sec_connection">Связь</string>
    <string name="auto_repair">Автовосстановление сопряжения</string>
    <string name="desc_auto_repair">Если телефон и наушники «забыли» друг друга, приложение снова сопряжёт их, как только наушники окажутся в режиме сопряжения. Выключите, если хотите отвязать наушники намеренно.</string>
